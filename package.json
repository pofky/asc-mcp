{
  "name": "@pofky/asc-mcp",
  "version": "1.13.0",
  "description": "App Store Connect MCP server: your AI agent ships your iOS app, from a new bundle id to App Store review. A fastlane alternative for AI agents. 45 tools: register bundle ids, App Store signing profiles, Xcode archive and upload, TestFlight groups and testers, metadata, age rating, screenshots, in-app purchases and subscriptions, a preflight audit, submit and release, plus reviews and sales. asc_guide flags every step Apple's API cannot do before you reach it. Works with Claude Code, Claude Desktop, Cursor, Windsurf or any MCP client. Six tools free with no limit; 7-day trial of the rest, no card.",
  "homepage": "https://asc-mcp.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pofky/asc-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/pofky/asc-mcp/issues"
  },
  "main": "dist/index.js",
  "bin": {
    "asc-mcp": "dist/index.js",
    "appstore-connect-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "docs": "tsc && node scripts/gen-docs.mjs",
    "lint": "tsc --noEmit",
    "mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "release": "node scripts/release.mjs",
    "check:site": "node scripts/check-site-strings.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "app-store-connect",
    "app-store-connect-api",
    "apple",
    "ios",
    "macos",
    "xcode",
    "appstore",
    "app-review",
    "app-review-status",
    "sales-report",
    "customer-reviews",
    "testflight",
    "claude",
    "claude-code",
    "cursor",
    "windsurf",
    "ai-agent",
    "ai-coding",
    "developer-tools",
    "fastlane",
    "fastlane-alternative",
    "release-automation",
    "app-store",
    "app-store-submission",
    "app-store-optimization",
    "ios-release",
    "asc",
    "bundle-id",
    "code-signing",
    "provisioning-profile",
    "xcodebuild",
    "age-rating",
    "app-store-screenshots",
    "in-app-purchase",
    "beta-testing",
    "ios-app-submission"
  ],
  "mcpName": "io.github.pofky/asc-mcp",
  "author": "pofky",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "skills/",
    "README.md",
    "USER_GUIDE.md",
    "LIMITATIONS.md",
    "LICENSE"
  ]
}
